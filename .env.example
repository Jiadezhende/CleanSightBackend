# ==================== CleanSight Backend 环境配置模板 ====================
# 复制此文件为 .env（生产）、.env.dev（开发）或 .env.test（测试）并填写实际值
#
# 环境切换方法（由启动脚本自动处理）：
#   .\start_backend.ps1 dev   # 开发环境（加载 .env.dev）
#   .\start_backend.ps1 test  # 测试环境（加载 .env.test）
#   .\start_backend.ps1 prod  # 生产环境（加载 .env）
#
# ⚠️  所有推理相关的配置（模型路径、阈值、告警等）已迁移到 app/config/stages_config.yaml

# ==================== 数据库配置（必需）====================
CLEANSIGHT_DB_HOST=your_db_host
CLEANSIGHT_DB_PORT=5432
CLEANSIGHT_DB_NAME=your_db_name
CLEANSIGHT_DB_USER=your_db_user
CLEANSIGHT_DB_PASSWORD=your_db_password

# ==================== 模型文件路径（可选）====================
# 模型文件夹基础路径（具体文件名由 stages_config.yaml 决定）
# 默认值（在yaml中）: ./app/data
# 示例:
#   生产环境: CLEANSIGHT_MODEL_PATH=/opt/models
#   开发环境: CLEANSIGHT_MODEL_PATH=./app/data
CLEANSIGHT_MODEL_PATH=./app/data

# ==================== 应用配置（可选）====================
# 调试模式
CLEANSIGHT_DEBUG=false

# 严格模式（生产环境建议开启，开发环境建议关闭）
# 开启后，缺少必需配置会导致启动失败
# 生产环境: CLEANSIGHT_STRICT=1
# 开发环境: CLEANSIGHT_STRICT=0
CLEANSIGHT_STRICT=1

# ==================== 外部接口URL（必需）====================
# HLS 段信息插入接口URL（用于与无代码平台集成）
CLEANSIGHT_FILE_PATH_INSERT_URL=http://your-server/api/file_path_insert

# 告警上报接口URL
CLEANSIGHT_ALARM_REPORT_URL=http://your-server/api/alarm_report

# ==================== 推理与视频配置（可选）====================
# 推理采样频率（控制推理、可视化和视频输出的统一帧率）
# 默认值: 20
# CLEANSIGHT_INFERENCE_FPS=20

# 视频段时长（秒）
# 默认值: 10
# CLEANSIGHT_CA_SEGMENT_SECONDS=10
