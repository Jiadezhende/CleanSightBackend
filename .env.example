# Example .env for CleanSightBackend (template)
# Copy to .env and fill in production values.

# Database
CLEANSIGHT_DB_HOST=your_db_host
CLEANSIGHT_DB_PORT=5432
CLEANSIGHT_DB_NAME=your_db_name
CLEANSIGHT_DB_USER=your_db_user
CLEANSIGHT_DB_PASSWORD=your_db_password

# Models
CLEANSIGHT_YOLO_MODEL_PATH=/opt/models/yolo/best.pt
CLEANSIGHT_YOLO_CONF_THRESHOLD=0.8
CLEANSIGHT_YOLO_IOU_THRESHOLD=0.45
CLEANSIGHT_BUBBLE_MODEL_PATH=/opt/models/bubble/best.pt
CLEANSIGHT_BUBBLE_CONF_THRESHOLD=0.8
CLEANSIGHT_BUBBLE_IOU_THRESHOLD=0.45

# strict validation
CLEANSIGHT_STRICT=1
