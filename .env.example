# ==================== CleanSight Backend 环境配置模板 ====================
# 复制此文件为 .env 并填写实际值
# 推理相关的详细配置请参考 app/config/stages_config.yaml

# ==================== 数据库配置 ====================
CLEANSIGHT_DB_HOST=your_db_host
CLEANSIGHT_DB_PORT=5432
CLEANSIGHT_DB_NAME=your_db_name
CLEANSIGHT_DB_USER=your_db_user
CLEANSIGHT_DB_PASSWORD=your_db_password

# ==================== 服务器配置 ====================
# CLEANSIGHT_SERVER_HOST=0.0.0.0
# CLEANSIGHT_SERVER_PORT=8000

# ==================== 应用配置 ====================
CLEANSIGHT_DEBUG=false

# ==================== 模型文件路径（可选） ====================
# 这些路径会被 stages_config.yaml 引用
CLEANSIGHT_YOLO_MODEL_PATH=/opt/data/yolo-best.pt
CLEANSIGHT_BUBBLE_MODEL_PATH=/opt/data/bubble-best.pt

# ==================== 告警上报 URL（可选） ====================
# CLEANSIGHT_ALARM_REPORT_URL=http://your-server/api/alarm_report
