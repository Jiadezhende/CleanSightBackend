# ==================== CleanSight Backend 环境配置模板 ====================
# 复制此文件为 .env（生产环境）或 .env.dev（开发环境）并填写实际值
#
# 环境加载优先级：
#   1. CLEANSIGHT_ENV_FILE 指定的文件路径（最高优先级）
#   2. CLEANSIGHT_PROD=1 时加载 .env（生产模式）
#   3. 默认加载 .env.dev（开发模式）
#
# ⚠️ 所有推理相关的配置（模型路径、阈值、告警等）已迁移到 app/config/stages_config.yaml

# ==================== 数据库配置（必需） ====================
CLEANSIGHT_DB_HOST=your_db_host
CLEANSIGHT_DB_PORT=5432
CLEANSIGHT_DB_NAME=your_db_name
CLEANSIGHT_DB_USER=your_db_user
CLEANSIGHT_DB_PASSWORD=your_db_password

# ==================== 模型文件路径（可选） ====================
# 模型文件夹基础路径（具体文件名由 stages_config.yaml 决定）
# 默认值（在yaml中）: ./app/data
# 示例:
#   生产环境: CLEANSIGHT_MODEL_PATH=/opt/models
#   开发环境: CLEANSIGHT_MODEL_PATH=./app/data
CLEANSIGHT_MODEL_PATH=./app/data

# ==================== 告警配置（可选） ====================
# 告警上报接口URL（在 stages_config.yaml 中使用）
# 默认值（在yaml中）: http://116.204.65.72:8881/gdmp/v1/api/nt/alarm_report
# ALARM_REPORT_URL=http://your-server/api/alarm_report

# ==================== 应用配置（可选） ====================
# 调试模式
# CLEANSIGHT_DEBUG=false

# 严格模式（生产环境建议开启，开发环境建议关闭）
# 开启后，缺少必需配置会导致启动失败
# CLEANSIGHT_STRICT=1

# HLS 段信息插入接口URL（用于与无代码平台集成）
# 如果为空，默认使用当前服务的 /api/file_path_insert
# CLEANSIGHT_FILE_PATH_INSERT_URL=

# ==================== 推理与视频配置（可选） ====================
# 推理采样频率（控制推理、可视化和视频输出的统一帧率）
# 默认值: 20
# CLEANSIGHT_INFERENCE_FPS=20

# 视频段时长（秒）
# 默认值: 10
# CLEANSIGHT_CA_SEGMENT_SECONDS=10

# ==================== 环境切换（高级） ====================
# 强制指定加载的环境文件路径（优先级最高）
# CLEANSIGHT_ENV_FILE=/path/to/custom.env

# 生产模式标志（设置为1时加载.env而非.env.dev）
# CLEANSIGHT_PROD=1
