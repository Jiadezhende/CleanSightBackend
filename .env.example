# ==================== CleanSight Backend 环境配置模板 ====================
# 复制此文件为 .env（生产）、.env.dev（开发）或 .env.test（测试）并填写实际值
#
# 环境切换方法（由启动脚本自动处理）：
#   .\start_backend.ps1 dev   # 开发环境（加载 .env.dev）
#   .\start_backend.ps1 test  # 测试环境（加载 .env.test）
#   .\start_backend.ps1 prod  # 生产环境（加载 .env）
#
# 注意: 推理相关配置（模型阈值、告警规则等）在 config/inference_config.yaml

# ==================== 数据库配置（必需）====================
CLEANSIGHT_DB_HOST=your_db_host
CLEANSIGHT_DB_PORT=5432
CLEANSIGHT_DB_NAME=your_db_name
CLEANSIGHT_DB_USER=your_db_user
CLEANSIGHT_DB_PASSWORD=your_db_password

# ==================== 外部接口URL（必需）====================
# 告警上报接口URL
CLEANSIGHT_ALARM_REPORT_URL=http://your-server/api/alarm_report

# ==================== 服务器配置（可选）====================
# 仅在通过 python -m app.main 启动时生效，启动脚本有自己的参数
# CLEANSIGHT_HOST=0.0.0.0
# CLEANSIGHT_PORT=8000

# ==================== 日志配置（可选）====================
# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
# CLEANSIGHT_LOG_LEVEL=INFO

# Uvicorn 日志配置文件路径
# CLEANSIGHT_LOG_CONFIG=logging_config.json

# ==================== 应用配置（可选）====================
# 调试模式（启用详细装饰器日志等）
CLEANSIGHT_DEBUG=false

# 严格模式（生产环境建议开启，开发环境建议关闭）
# 开启后，缺少必需配置会导致启动失败
CLEANSIGHT_STRICT=1

# ==================== 模型与工具（可选）====================
# 模型文件夹基础路径（具体文件名由 inference_config.yaml 决定）
# 默认值: ./app/data
CLEANSIGHT_MODEL_PATH=./app/data

# FFmpeg 二进制路径（默认留空 = 锁定项目内钉版 .ffmpeg/bin/ffmpeg，不回退 PATH，缺料即报错）
# 仅当需指向其它 ffmpeg（如 Mac 开发机用 homebrew）时才显式设置。
# CLEANSIGHT_FFMPEG_PATH=

# ==================== API Gateway（可选）====================
# 关闭网关（仅调试用，生产环境勿用）
# CLEANSIGHT_GATEWAY_ENABLED=true

# IP 白名单（逗号分隔，空=不限制；IP 固定后在此填写）
# CLEANSIGHT_GATEWAY_ALLOWED_IPS=10.0.0.1,10.0.0.2

# 普通接口速率限制（每窗口最大请求数 / 窗口秒数）
# CLEANSIGHT_GATEWAY_RATE_LIMIT=60
# CLEANSIGHT_GATEWAY_RATE_WINDOW=60

# 速率超限升级封禁：窗口内持续超限违规达到阈值后封禁该 IP（0=不封禁）
# CLEANSIGHT_GATEWAY_RATE_BAN_THRESHOLD=5
# CLEANSIGHT_GATEWAY_RATE_BAN_WINDOW=60

# 宽松路径：高频轮询接口，独立高配额 bucket，不计入封禁升级和扫描检测
# 前缀匹配（逗号分隔）。/media 不在此列——它走下方 BYPASS_PREFIXES（更高一档，
# 完全跳过限流），因为段请求自带 HMAC token 鉴权且频次远超 600/60s。
# CLEANSIGHT_GATEWAY_RELAXED_PREFIXES=/health,/task/message,/task/live,/task/history,/traceback,/admin-f3m8,/metrics
# CLEANSIGHT_GATEWAY_RELAXED_RATE_LIMIT=600

# 绕过路径：完全跳过限流与反扫描，仅保留 IP 白名单/封禁检查。
# 只给自带强鉴权的路由（/media/* 的 token 验不过即 403，无可枚举面）。
# CLEANSIGHT_GATEWAY_BYPASS_PREFIXES=/media

# 反扫描：窗口内 404/405 次数达到阈值后封禁该 IP
# CLEANSIGHT_GATEWAY_SCAN_THRESHOLD=10
# CLEANSIGHT_GATEWAY_SCAN_WINDOW=300
# CLEANSIGHT_GATEWAY_BAN_DURATION=3600
