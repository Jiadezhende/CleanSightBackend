# Development .env.dev for CleanSightBackend
# 用于本地开发，请根据本地环境调整并不要提交带有敏感信息的真实密码到远程仓库

# Local DB (示例：本地 Postgres 或 Docker)
CLEANSIGHT_DB_HOST=116.204.65.72
CLEANSIGHT_DB_PORT=5432
CLEANSIGHT_DB_NAME=aidkdb
CLEANSIGHT_DB_USER=aidk
CLEANSIGHT_DB_PASSWORD=aidk

# AI model paths - 在开发环境中可以使用仓库内的小模型或测试权重
CLEANSIGHT_YOLO_MODEL_PATH=app/data/bend-best.pt
CLEANSIGHT_BUBBLE_MODEL_PATH=app/data/bubble-best.pt

# 指定开发模式，使 Settings 在加载时尝试读取 .env.dev
CLEANSIGHT_STRICT=0
